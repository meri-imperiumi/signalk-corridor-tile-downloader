{
  "name": "@meri-imperiumi/signalk-corridor-tile-downloader",
  "version": "0.3.0",
  "description": "Pre-cache marine chart tiles along a route for offline navigation",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meri-imperiumi/signalk-corridor-tile-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-corridor-tile-downloader/issues"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-corridor-tile-downloader#readme",
  "scripts": {
    "format": "npx @biomejs/biome check --use-editorconfig=true --write index.js lib/ test/ public/",
    "lint": "npx @biomejs/biome check --use-editorconfig=true index.js lib/ public/",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Corridor Tile Downloader",
    "appIcon": "./icon.png",
    "screenshots": [
      "./doc/download.png"
    ],
    "requires": [
      "signalk-charts-provider-simple",
      "@meri-imperiumi/signalk-internet"
    ]
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@signalk/server-api": "^2.30.0"
  }
}
